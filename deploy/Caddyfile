# Reverse proxy for the four hermes-agent API servers. One vhost per member,
# routed purely by FQDN. Each hermes-agent API server stays bound to
# 127.0.0.1 (see 04-enable-api-server.sh) — Caddy is the ONLY thing with a
# public listener, so the "full toolset access, including terminal commands"
# surface the API server docs warn about is never directly reachable.
#
# TLS is issued via dynv6 DNS-01 (see update-dynv6-records.sh for the zone/
# credential story), so port 80 / HTTP-01 is never needed — only 443.
#
# 1=robert 2=sofia 3=mattis 4=love — must match 04-enable-api-server.sh and
# update-dynv6-records.sh.

{
	# Let's Encrypt uses this for expiry/revocation notices only — not
	# user-facing. Change if you'd rather use a different address.
	email robert.gartman.sweden@gmail.com
}

1.agent-hermes.dynv6.net {
	tls {
		dns dynv6 {env.DYNV6_API_TOKEN}
	}

	# /health answers UNAUTHENTICATED with the exact Hermes version:
	#   {"status":"ok","platform":"hermes-agent","version":"0.19.0"}
	# That is free reconnaissance for anyone on the internet, and this
	# deployment deliberately runs a pinned (old) version. It grants no
	# access, but the external boundary is a strict requirement, so the
	# endpoint is not published. Nothing here monitors it.
	handle /health {
		respond 404
	}

	reverse_proxy 127.0.0.1:8642
}

2.agent-hermes.dynv6.net {
	tls {
		dns dynv6 {env.DYNV6_API_TOKEN}
	}

	# /health answers UNAUTHENTICATED with the exact Hermes version:
	#   {"status":"ok","platform":"hermes-agent","version":"0.19.0"}
	# That is free reconnaissance for anyone on the internet, and this
	# deployment deliberately runs a pinned (old) version. It grants no
	# access, but the external boundary is a strict requirement, so the
	# endpoint is not published. Nothing here monitors it.
	handle /health {
		respond 404
	}

	reverse_proxy 127.0.0.1:8643
}

3.agent-hermes.dynv6.net {
	tls {
		dns dynv6 {env.DYNV6_API_TOKEN}
	}

	# /health answers UNAUTHENTICATED with the exact Hermes version:
	#   {"status":"ok","platform":"hermes-agent","version":"0.19.0"}
	# That is free reconnaissance for anyone on the internet, and this
	# deployment deliberately runs a pinned (old) version. It grants no
	# access, but the external boundary is a strict requirement, so the
	# endpoint is not published. Nothing here monitors it.
	handle /health {
		respond 404
	}

	reverse_proxy 127.0.0.1:8644
}

4.agent-hermes.dynv6.net {
	tls {
		dns dynv6 {env.DYNV6_API_TOKEN}
	}

	# /health answers UNAUTHENTICATED with the exact Hermes version:
	#   {"status":"ok","platform":"hermes-agent","version":"0.19.0"}
	# That is free reconnaissance for anyone on the internet, and this
	# deployment deliberately runs a pinned (old) version. It grants no
	# access, but the external boundary is a strict requirement, so the
	# endpoint is not published. Nothing here monitors it.
	handle /health {
		respond 404
	}

	reverse_proxy 127.0.0.1:8645
}

# 5 = Robert's Hermes web dashboard — ADMIN SURFACE, adult operator only.
#
# Deliberately NOT a chat endpoint for the family. The Hermes web UI is a
# single SPA: the same server that serves /chat also serves /env (the
# profile's environment variables, Scaleway key included), /config and
# /files. Path-filtering here would not separate them — those routes are
# client-side views over a shared /api/*, so anyone who could reach /chat
# could call the config and env endpoints directly. Family chat therefore
# stays on the per-member API servers above, which expose conversation and
# nothing else. See ADR-014.
#
# Two doors, two controls, and basic_auth only covers one of them:
#   - public door  -> basic_auth here
#   - loopback door -> nftables, because 127.0.0.1 is shared by all four
#     member gateways (measured: a child's agent got HTTP 200 against this
#     dashboard before the rule existed). See nftables-hermes.conf.
#
# ROBERT_DASH_HASH is a bcrypt hash supplied through caddy.service's
# EnvironmentFile, never stored in this repository.
5.agent-hermes.dynv6.net {
	tls {
		dns dynv6 {env.DYNV6_API_TOKEN}
	}
	basic_auth {
		robert {env.ROBERT_DASH_HASH}
	}
	# The dashboard enforces DNS-rebinding protection: it rejects any request
	# whose Host header is not the address it bound to, with
	#   400 {"detail":"Invalid Host header..."}
	# That reads like a proxy misconfiguration but is the backend refusing on
	# purpose. Rewrite Host to the upstream so it sees 127.0.0.1:9121.
	# Do NOT "fix" this by binding the dashboard to a public interface —
	# Caddy must remain the only public listener.
	reverse_proxy 127.0.0.1:9121 {
		header_up Host {upstream_hostport}
	}
}

# 6 = the tutor's JupyterLab, for all four members.
#
# This publishes a CODE EXECUTION surface to the internet. It is acceptable
# only because of what sits in front of and behind it:
#   - basic_auth per member here (bcrypt hashes via caddy.service EnvironmentFile)
#   - Jupyter's own token, injected below so members never handle it
#   - the kernel runs in a container that can reach NO host port (nftables)
#   - each member has their own notebook path, so their own kernel
# Numeric label per ADR-006: a "jupyter." label would advertise a public
# code-execution endpoint in Certificate Transparency logs forever.
6.agent-hermes.dynv6.net {
	tls {
		dns dynv6 {env.DYNV6_API_TOKEN}
	}
	basic_auth {
		robert {env.LAB_HASH_ROBERT}
		sofia {env.LAB_HASH_SOFIA}
		mattis {env.LAB_HASH_MATTIS}
		love {env.LAB_HASH_LOVE}
	}
	reverse_proxy 10.89.1.10:8888 {
		# Jupyter enforces DNS-rebinding protection like the dashboard does:
		# without this it answers 403 to every proxied request.
		header_up Host {upstream_hostport}
		# Inject the server token so members authenticate with their own
		# password only. The token never leaves the host.
		header_up Authorization "token {env.LAB_TOKEN}"
	}
}
